# Serveur IMAP — ne jamais versionner ce fichier
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=votre.adresse@example.com
IMAP_PASSWORD=mot-de-passe-factice
IMAP_SECURE=true

# true  = 30 emails factices en français, aucune connexion IMAP
# false = connexion réelle à votre compte
DEMO_MODE=true

# SMTP (facultatif : déduit automatiquement pour Gmail depuis IMAP_*)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=votre.adresse@example.com
# SMTP_PASSWORD=mot-de-passe-factice

# Webhooks n8n (facultatifs : repli local si absents)
# N8N_WEBHOOK_URL=https://votre-instance-n8n.com/webhook/generate-reply
# N8N_SEND_WEBHOOK_URL=https://votre-instance-n8n.com/webhook/send-email
# N8N_DETECT_MEETING_WEBHOOK_URL=https://votre-instance-n8n.com/webhook/detect-meeting
N8N_WEBHOOK_URL=
N8N_SEND_WEBHOOK_URL=
N8N_DETECT_MEETING_WEBHOOK_URL=

# Port de l'API locale
PORT=3001
